<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Blue outline when the user selects this field -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sp_surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sp_primary" />
        </shape>
    </item>

    <!-- Normal appearance -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sp_surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/sp_border" />
        </shape>
    </item>

</selector>