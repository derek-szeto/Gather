<?xml version="1.0" encoding="utf-8"?>
<resources>


    <color name="sp_background">#F4F8F7</color>
    <color name="sp_surface">#FFFFFF</color>
    <color name="sp_primary">#176C5B</color>
    <color name="sp_primary_light">#E6F3EF</color>
    <color name="sp_accent">#72E2BC</color>
    <color name="sp_text">#132B2D</color>
    <color name="sp_secondary_text">#536C6B</color>
    <color name="sp_border">#D7E6E1</color>

    <style name="SPHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sp_text</item>
        <item name="android:textSize">28sp</item>
        <item name="fontFamily">@font/space_grotesk_bold</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="SPBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sp_secondary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="fontFamily">@font/space_grotesk_regular</item>
        <item name="android:fontFamily">@font/space_grotesk_regular</item>
    </style>

    <style name="SPLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/sp_text</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
    </style>

    <style name="SPInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/sp_input</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/sp_text</item>
        <item name="android:textColorHint">@color/sp_secondary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/space_grotesk_regular</item>
        <item name="android:fontFamily">@font/space_grotesk_regular</item>
    </style>

    <style name="GatherPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/sp_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="fontFamily">@font/space_grotesk_medium</item>
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textColor">@color/sp_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="GatherSecondaryButton" parent="GatherPrimaryButton">
        <item name="backgroundTint">@color/sp_primary_light</item>
        <item name="android:textColor">@color/sp_primary</item>
    </style>

    <string name="sp_saved_plans">Your plans</string>
    <string name="sp_choose_time">Choose date and time</string>

</resources>