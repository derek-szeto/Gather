<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App colors -->
    <color name="sp_background">#F4F7FC</color>
    <color name="sp_surface">#FFFFFF</color>
    <color name="sp_primary">#315DCC</color>
    <color name="sp_primary_light">#E8EEFF</color>
    <color name="sp_text">#17243D</color>
    <color name="sp_secondary_text">#526078</color>
    <color name="sp_border">#CBD5E5</color>

    <!-- A consistent light theme for this first version -->
    <style
        name="Theme.Gather."
        parent="Theme.AppCompat.Light.NoActionBar">

        <item name="colorPrimary">@color/sp_primary</item>
        <item name="colorPrimaryDark">@color/sp_primary</item>
        <item name="colorAccent">@color/sp_primary</item>

        <item name="android:windowBackground">@color/sp_background</item>
        <item name="android:colorBackground">@color/sp_background</item>
        <item name="android:textColorPrimary">@color/sp_text</item>
        <item name="android:textColorSecondary">@color/sp_secondary_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SPHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sp_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SPBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sp_secondary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="SPLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/sp_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SPInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/sp_input</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/sp_text</item>
        <item name="android:textColorHint">@color/sp_secondary_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SPPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/sp_primary</item>
        <item name="android:textColor">@color/sp_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SPSecondaryButton" parent="SPPrimaryButton">
        <item name="backgroundTint">@color/sp_primary_light</item>
        <item name="android:textColor">@color/sp_primary</item>
    </style>

    <string name="sp_saved_plans">Your plans</string>
    <string name="sp_choose_time">Choose date and time</string>

</resources>