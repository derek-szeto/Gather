<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="gather."
            android:textColor="@color/sp_text"
            android:textSize="28sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/legacyHomeButton"
            style="@style/GatherSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Home"
            app:icon="@drawable/ic_home"
            app:iconTint="@color/sp_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ON-DEVICE PLANS"
            android:textColor="@color/sp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your plans"
            android:textColor="@color/sp_text"
            android:textSize="22sp" />

        <TextView
            style="@style/SPBody"
            android:layout_marginTop="4dp"
            android:text="Places and itineraries saved on this device." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newButton"
            style="@style/GatherPrimaryButton"
            android:layout_marginTop="18dp"
            android:text="New on-device plan" />

        <TextView
            android:id="@+id/statusText"
            style="@style/SPBody"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/hp_loading" />

        <ListView
            android:id="@+id/hangoutList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/formPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/formHeading"
                style="@style/SPHeading"
                android:text="@string/hp_new_hangout"
                android:textStyle="normal" />

            <TextView
                style="@style/SPBody"
                android:layout_marginTop="8dp"
                android:text="Name your plan and find places to go." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/sp_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/SPLabel"
                    android:layout_marginTop="0dp"
                    android:labelFor="@id/titleInput"
                    android:text="Hangout name *" />

                <EditText
                    android:id="@+id/titleInput"
                    style="@style/SPInput"
                    android:hint="Saturday with friends"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:maxLines="1" />

                <TextView
                    style="@style/SPLabel"
                    android:labelFor="@id/cityInput"
                    android:text="Area or address (optional)" />

                <EditText
                    android:id="@+id/cityInput"
                    style="@style/SPInput"
                    android:hint="Leave blank to use your location"
                    android:inputType="textPostalAddress"
                    android:maxLength="200"
                    android:maxLines="2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/findPlacesButton"
                    style="@style/GatherPrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="Find a place" />

                <TextView
                    android:id="@+id/selectedPlacesStatus"
                    style="@style/SPBody"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="No places selected yet." />

                <LinearLayout
                    android:id="@+id/selectedPlacesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/SPLabel"
                    android:labelFor="@id/whenInput"
                    android:text="@string/hp_when_label" />

                <EditText
                    android:id="@+id/whenInput"
                    style="@style/SPInput"
                    android:hint="@string/hp_when_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chooseTimeButton"
                    style="@style/GatherSecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/sp_choose_time" />

                <TextView
                    style="@style/SPLabel"
                    android:labelFor="@id/notesInput"
                    android:text="@string/hp_notes_label" />

                <EditText
                    android:id="@+id/notesInput"
                    style="@style/SPInput"
                    android:gravity="top"
                    android:hint="@string/hp_notes_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="2000"
                    android:minLines="3" />

                <TextView
                    style="@style/SPBody"
                    android:layout_marginTop="16dp"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:textSize="12sp"
                    android:text="Powered by Geoapify: https://www.geoapify.com\n© OpenStreetMap contributors: https://www.openstreetmap.org/copyright" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/GatherPrimaryButton"
                android:layout_marginTop="20dp"
                android:text="Save plan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/GatherSecondaryButton"
                android:text="@string/hp_cancel" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>