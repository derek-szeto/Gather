<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sp_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stopNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/itinerary_number_badge"
            android:gravity="center"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="@color/sp_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stopName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:fontFamily="@font/space_grotesk_medium"
            android:textColor="@color/sp_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/stopTime"
        style="@style/SPBody"
        android:layout_marginTop="12dp"
        android:textColor="@color/sp_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stopAddress"
        style="@style/SPBody"
        android:layout_marginTop="2dp"
        android:maxLines="3" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tap to change time or order"
        android:textColor="@color/sp_secondary_text"
        android:textSize="12sp" />
</LinearLayout>