<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sp_card"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="116dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/legacyPlanTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_grotesk_medium"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/sp_text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/legacyPlanArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/sp_secondary_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/legacyPlanTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/sp_secondary_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="View itinerary and options  →"
        android:textColor="@color/sp_primary"
        android:textSize="13sp" />

</LinearLayout>