<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itineraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backButton"
            style="@style/SPSecondaryButton"
            android:text="Back to hangouts" />

        <TextView
            android:id="@+id/itineraryTitle"
            style="@style/SPHeading"
            android:layout_marginTop="16dp"
            android:text="Itinerary" />

        <TextView
            android:id="@+id/itineraryCity"
            style="@style/SPBody"
            android:layout_marginTop="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/addStopButton"
            style="@style/SPPrimaryButton"
            android:layout_marginTop="20dp"
            android:text="Find and add a stop" />

        <TextView
            android:id="@+id/itineraryStatus"
            style="@style/SPBody"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="Loading stops…" />

        <ListView
            android:id="@+id/stopsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            style="@style/SPBody"
            android:layout_marginTop="12dp"
            android:autoLink="web"
            android:linksClickable="true"
            android:textSize="12sp"
            android:text="Powered by Geoapify: https://www.geoapify.com\n© OpenStreetMap contributors: https://www.openstreetmap.org/copyright" />

    </LinearLayout>

</LinearLayout>