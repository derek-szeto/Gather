<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itineraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeButton"
                style="@style/GatherSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_home"
                android:drawablePadding="4dp"
                android:drawableTint="@color/sp_primary"
                android:gravity="center"
                android:text="Home"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/GatherSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.4"
                android:text="Back to plans"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ON-DEVICE ITINERARY"
            android:letterSpacing="0.14"
            android:textColor="@color/sp_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itineraryTitle"
            style="@style/SPHeading"
            android:layout_marginTop="8dp"
            android:letterSpacing="-0.02"
            android:text="Itinerary" />

        <TextView
            android:id="@+id/itineraryCity"
            style="@style/SPBody"
            android:layout_marginTop="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addStopButton"
            style="@style/GatherPrimaryButton"
            android:layout_marginTop="20dp"
            android:text="Find and add a stop" />

        <TextView
            android:id="@+id/itineraryStatus"
            style="@style/SPBody"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="Loading stops…" />

        <ListView
            android:id="@+id/stopsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="12dp" />

        <TextView
            style="@style/SPBody"
            android:autoLink="web"
            android:linksClickable="true"
            android:text="Powered by Geoapify: https://www.geoapify.com\n© OpenStreetMap contributors: https://www.openstreetmap.org/copyright"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>